  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  schoolId       String?
  school         School?       @relation(fields: [schoolId], references: [id])
  campusId       String?
  campus         Campus?       @relation(fields: [campusId], references: [id])
  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])
  roleId         String
  role           Role          @relation(fields: [roleId], references: [id])
  isActive       Boolean       @default(true)
  validFrom      DateTime?     @default(now())
  validUntil     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId, organizationId, isActive])
  @@index([organizationId, schoolId, campusId])
}

model AuthorityDelegation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  schoolId       String?
  school         School?      @relation(fields: [schoolId], references: [id])
  campusId       String?
  campus         Campus?      @relation(fields: [campusId], references: [id])
  delegatorId    String
  delegator      User         @relation("DelegatorUser", fields: [delegatorId], references: [id])
  delegateeId    String
  delegatee      User         @relation("DelegateeUser", fields: [delegateeId], references: [id])
  roleId         String?
  role           Role?        @relation(fields: [roleId], references: [id])
  permissions    String[]     // List of permission keys delegated
  scope          String       @default("SCHOOL") // ORGANIZATION, SCHOOL, CAMPUS
  validFrom      DateTime     @default(now())
  validUntil     DateTime
  isActive       Boolean      @default(true)
  reason         String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, schoolId, delegateeId, isActive])
  @@index([delegatorId, validUntil])
}

// ==========================================
// Phase 0.4: Master Data & Configuration Control Plane Models
// ==========================================
model Shift {
  id        String   @id @default(uuid())
  name      String   // e.g., "Morning Shift", "Afternoon Shift"
  code      String?
  startTime String   // e.g. "08:00"
  endTime   String   // e.g. "14:00"
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
}

model NumberSequence {
  id             String    @id @default(uuid())
  organizationId String
  schoolId       String?
  entityType     String    // e.g. "STUDENT_ADMISSION", "INVOICE", "RECEIPT", "EMPLOYEE_ID", "PURCHASE_ORDER"
  prefix         String    @default("") // e.g. "ADM-2026-"
  suffix         String    @default("")
  nextNumber     Int       @default(1)
  padding        Int       @default(5)  // Number of digits e.g. 00001
  resetPolicy    String    @default("NEVER") // NEVER, YEARLY, MONTHLY
  lastResetAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([organizationId, schoolId, entityType])
}

model SchoolModuleConfig {
  id          String   @id @default(uuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  moduleKey   String   // e.g. "academics", "finance", "attendance", "cbt", "biometric"
  enabled     Boolean  @default(true)
  settings    Json?    // Typed module settings
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([schoolId, moduleKey])
}

model ConfigurationAudit {
  id             String   @id @default(uuid())
  organizationId String
  schoolId       String?
  category       String   // e.g. "ORGANIZATION", "SCHOOL", "ACADEMIC", "NUMBERING"
  key            String
  previousValue  Json?
  newValue       Json?
  changedById    String
  reason         String?
  createdAt      DateTime @default(now())

  @@index([organizationId, schoolId, category])
}

// ==========================================
// Phase 1.0: Canonical Person 360 & Student Domain Models
// ==========================================
model Person {
  id              String        @id @default(uuid())
  firstName       String
  middleName      String?
  lastName        String
  displayName     String?
  dateOfBirth     DateTime?
  gender          String?
  nationality     String?
  primaryLanguage String?
  profilePhoto    String?
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  students        Student[]
  guardians       Guardian[]
  contacts        ContactMethod[]
  addresses       Address[]

  @@index([organizationId, lastName, firstName])
}

model ContactMethod {
  id          String   @id @default(uuid())
  personId    String
  person      Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  type        String   // MOBILE, EMAIL, WHATSAPP, EMERGENCY
  value       String
  isPrimary   Boolean  @default(false)
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([personId, type])
}

model Address {
  id          String   @id @default(uuid())
  personId    String
  person      Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  type        String   // HOME, WORK, HOSTEL, OTHER
  line1       String
  line2       String?
  city        String
  state       String
  country     String   @default("US")
  postalCode  String
  isPrimary   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([personId])
}

model StudentNote {
  id          String   @id @default(uuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  category    String   @default("GENERAL") // GENERAL, ACADEMIC, DISCIPLINE, COUNSELING, HEALTH, ADMINISTRATIVE
  content     String
  isPrivate   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([studentId, category])
}




