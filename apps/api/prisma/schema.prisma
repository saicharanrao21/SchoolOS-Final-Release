model Organization {
  id          String   @id @default(uuid())
  name        String
  displayName String?
  code        String?  @unique
  slug        String   @unique
  address     String?
  phone       String?
  email       String?
  website     String?
  timezone    String   @default("UTC")
  currency    String   @default("USD")
  locale      String   @default("en-US")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schools     School[]
  users       User[]
  documents    DmsDocument[]
  certificates CertificateIssue[]
  importJobs   ImportJob[]
  exportJobs   ExportJob[]
  analyticsDashboards AnalyticsDashboard[]
  analyticsReports    AnalyticsSavedReport[]
  workflowDefinitions WorkflowDefinition[]
  workflowInstances   WorkflowInstance[]
  workflowDelegations WorkflowDelegation[]
  transportMaintenances TransportMaintenance[]
  communicationCampaigns CommunicationCampaign[]
  saasSubscription    SaaSSubscription?
  saasInvoices        SaaSInvoice[]
  saasPayments        SaaSPayment[]
  saasCouponRedemptions SaaSCouponRedemption[]
  internalExpenses    InternalExpense[]
  internalVendors     InternalVendor[]
  legalMatters        LegalMatter[]
  companyContracts    CompanyContract[]
  platformSupportSessions PlatformSupportSession[]
  auditLogs   AuditEvent[]
  behaviorIncidents BehaviorIncident[]
  behaviorActions BehaviorAction[]
  behaviorPointEntries BehaviorPointLedger[]
  counselingSessions StudentCounselingSession[]
  lmsCourses       LmsCourse[]
  lmsEnrollments   LmsEnrollment[]
  lmsLiveClasses   LmsLiveClass[]
  communicationThreads CommunicationThread[] @relation("OrganizationCommunicationThreads")
  biometricDevices BiometricDevice[]
  biometricPunchLogs BiometricPunchLog[]
  aiKnowledgeBases AiKnowledgeBase[]
  aiUsageLogs AiUsageLog[]
  websitePages WebsitePage[]
  phoneCallLogs PhoneCallLog[]
  postalRecords PostalRecord[]
  cctvCameras CctvCamera[]
  cbtQuestionBanks CbtQuestionBank[]
  cbtExams CbtExam[]
  userMemberships UserMembership[]
  authorityDelegations AuthorityDelegation[]
  people Person[]
}

model School {
  id             String       @id @default(uuid())
  name           String
  displayName    String?
  code           String?
  slug           String?      @unique
  legalName      String?
  affiliation    String?
  logo           String?
  address        String?
  city           String?
  state          String?
  country        String?
  postalCode     String?
  phone          String?
  email          String?
  website        String?
  timezone       String       @default("UTC")
  currency       String       @default("USD")
  locale         String       @default("en-US")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  campuses           Campus[]
  academicYears      AcademicYear[]
  departments        Department[]
  classes            Class[]
  subjects           Subject[]
  houses             House[]
  settings           SchoolSetting[]
  students           Student[]
  employees          Employee[]
  enquiries          AdmissionEnquiry[]
  applications       AdmissionApplication[]
  feeCategories      FeeCategory[]
  feeStructures      FeeStructure[]
  fiscalYears        FiscalYear[]
  accounts           ChartOfAccount[]
  journals           Journal[]
  costCenters        CostCenter[]
  attendancePolicies AttendancePolicy[]
  attendanceSessions AttendanceSession[]
  leaveTypes         LeaveType[]
  curriculums        Curriculum[]
  teacherAvailabilities TeacherAvailability[]
  timetablePeriods   TimetablePeriod[]
  timetables         Timetable[]
  assignments        Assignment[]
  examTypes          ExamType[]
  assessmentComponents AssessmentComponent[]
  examinations       Examination[]
  gradingSystems     GradingSystem[]
  reportCardTemplates ReportCardTemplate[]
  notificationTemplates NotificationTemplate[]
  notificationProviders NotificationProvider[]
  announcements      SchoolAnnouncement[]
  transportPolicies  TransportPolicy[]
  vehicles           Vehicle[]
  routes             TransportRoute[]
  transportMaintenances TransportMaintenance[]
  communicationCampaigns CommunicationCampaign[]
  libraries          Library[]
  hostels            Hostel[]
  hostelInspections  HostelRoomInspection[]
  hostelVisitors     HostelVisitor[]
  hostelMessRecords  HostelMessAttendance[]
  hostelTransfers   HostelAllocationTransfer[]
  events             SchoolEvent[]
  ptmEvents          PtmEvent[]
  lmsCourses         LmsCourse[]
  lmsLiveClasses     LmsLiveClass[]
  feeLateFeeRules    FeeLateFeeRule[]
  designations       Designation[]
  payrollPeriods     PayrollPeriod[]
  salaryStructures   SalaryStructure[]
  vendors            Vendor[]
  warehouses         InventoryWarehouse[]
  purchaseRequests   PurchaseRequest[]
  purchaseOrders     PurchaseOrder[]
  goodsReceipts      GoodsReceipt[]
  inventoryItems     InventoryItem[]
  inventoryCategories InventoryCategory[]
  assetCategories    AssetCategory[]
  assets             Asset[]
  securityZones      SecurityZone[]
  securityGates      SecurityGate[]
  visitors           Visitor[]
  pickupRequests     PickupRequest[]
  incidents          Incident[]
  documents          DmsDocument[]
  certificateTemplates CertificateTemplate[]
  certificates       CertificateIssue[]
  importJobs         ImportJob[]
  exportJobs         ExportJob[]
  analyticsDashboards AnalyticsDashboard[]
  analyticsReports    AnalyticsSavedReport[]
  workflowDefinitions WorkflowDefinition[]
  workflowInstances   WorkflowInstance[]
  auditLogs          AuditEvent[]
  medicalProfiles     StudentMedicalProfile[]
  medicalVisits       StudentMedicalVisit[]
  medications         StudentMedication[]
  behaviorIncidents   BehaviorIncident[]
  behaviorActions     BehaviorAction[]
  behaviorPointEntries BehaviorPointLedger[]
  counselingSessions  StudentCounselingSession[]
  employeeDocuments EmployeeDocument[]
  performanceReviews PerformanceReview[]
  employeeTrainings EmployeeTraining[]
  communicationThreads CommunicationThread[] @relation("SchoolCommunicationThreads")
  biometricDevices BiometricDevice[]
  biometricPunchLogs BiometricPunchLog[]
  aiKnowledgeBases AiKnowledgeBase[]
  aiUsageLogs AiUsageLog[]
  websitePages WebsitePage[]
  phoneCallLogs PhoneCallLog[]
  postalRecords PostalRecord[]
  cctvCameras CctvCamera[]
