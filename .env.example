# ============================================================
# SCHOOLOS — ENTERPRISE ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================

# Application Environment
APP_ENV=development # development, test, staging, production
PORT=3000
LOG_LEVEL=info # debug, info, warn, error
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api/v1
WEB_URL=http://localhost:3001

# Database Configuration (PostgreSQL + Prisma)
DATABASE_URL="postgresql://schoolos_user:schoolos_password@localhost:5432/schoolos_db?schema=public&connection_limit=20"
DIRECT_URL="postgresql://schoolos_user:schoolos_password@localhost:5432/schoolos_db?schema=public"

# Redis & Queue Configuration
REDIS_URL="redis://localhost:6379"

# Security & JWT Tokens
JWT_SECRET="replace-with-a-secure-256-bit-secret-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-a-secure-refresh-token-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Payment Gateways (SaaS Billing & School Fees)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="replace-with-razorpay-secret"
RAZORPAY_WEBHOOK_SECRET="replace-with-razorpay-webhook-secret"

STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# Observability & Error Tracking
SENTRY_DSN=""

# Storage Configuration (DMS Documents & Report Cards)
STORAGE_DRIVER=local # local, s3
STORAGE_LOCAL_PATH="./uploads"
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"

# Notification gateway credential encryption (32+ character secret recommended)
NOTIFICATION_CONFIG_ENCRYPTION_KEY=replace-with-high-entropy-secret
